@page "/timelines/{TimelineId:guid}"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Timeline events</PageTitle>

<section class="event-page">
    <div class="event-toolbar">
        <div class="timeline-editor-heading">
            <p class="eyebrow">Timeline Editor</p>
            <h1>@(timeline?.Title ?? "Timeline events")</h1>
            <div class="timeline-editor-summary">
                @if (timeline?.ImageUrl is not null)
                {
                    <img src="@ApiUrl(timeline.ImageUrl)" alt="" class="timeline-editor-thumbnail" />
                }
                <p class="page-introduction">@(string.IsNullOrWhiteSpace(timeline?.Description) ? "Add a description to introduce this timeline." : timeline.Description)</p>
            </div>
        </div>
        <div class="toolbar-actions">
            <a class="event-selection-action" href="@($"timelines/{TimelineId:N}/timeline")">
                <span class="event-selection-action-icon" aria-hidden="true">◷</span>
                <span>Render Timeline</span>
            </a>
            <button class="event-selection-action" type="button" @onclick="OpenTimelineEditor" disabled="@(timeline is null)">
                <span class="event-selection-action-icon" aria-hidden="true">✎</span>
                <span>Edit Details</span>
            </button>
            <button class="event-selection-action event-selection-action-danger" type="button" @onclick="OpenTimelineDeleteConfirmation" disabled="@(timeline is null)">
                <span class="event-selection-action-icon" aria-hidden="true">⌫</span>
                <span>Delete Timeline</span>
            </button>
        </div>
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else if (events is null)
    {
        <p>Loading events...</p>
    }
    else if (events.Count == 0)
    {
        <div class="empty-events">
            <p class="text-muted">No events have been added yet.</p>
            <button class="event-selection-action" type="button" @onclick="OpenCreate">
                <span class="event-selection-action-icon" aria-hidden="true">+</span>
                <span>Add event</span>
            </button>
        </div>
    }
    else
    {
        <div class="event-editor-columns @(SelectedEvent is null ? null : "event-editor-columns-selected")">
            <div>
                <div class="event-table-actions">
                    <button class="event-selection-action" type="button" @onclick="OpenCreate">
                        <span class="event-selection-action-icon" aria-hidden="true">+</span>
                        <span>Add event</span>
                    </button>
                </div>
                <div class="event-table-surface table-responsive">
                    <table class="table table-hover align-middle event-table">
                        <thead>
                            <tr>
                                <th scope="col">Start date</th>
                                <th scope="col">End date</th>
                                <th scope="col">Title</th>
                                <th scope="col">Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var historicalEvent in events)
                            {
                                <tr class="event-selectable-row @(selectedEventId == historicalEvent.Id ? "event-row-selected" : null)"
                                    tabindex="0"
                                    @onclick="() => SelectEvent(historicalEvent.Id)"
                                    @onkeydown="(args) => SelectEventOnKeyDown(args, historicalEvent.Id)">
                                    <td class="event-date">@historicalEvent.StartDate.ToString("d MMM yyyy")</td>
                                    <td class="event-date">@historicalEvent.EndDate.ToString("d MMM yyyy")</td>
                                    <td>
                                        <div class="event-title">
                                            @if (historicalEvent.ImageUrl is not null)
                                            {
                                                <img src="@ApiUrl(historicalEvent.ImageUrl)" alt="" class="event-thumbnail" />
                                            }
                                            <span>@historicalEvent.Title</span>
                                        </div>
                                    </td>
                                    <td>@historicalEvent.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (SelectedEvent is { } selectedEvent)
            {
                <aside class="event-preview" aria-live="polite">
                    <article class="event-preview-content">
                        <section class="event-selection-toolbar" aria-label="Selected event actions">
                            <div class="event-selection-actions">
                                <button class="event-selection-action" type="button" @onclick="EditSelectedEvent">
                                    <span class="event-selection-action-icon" aria-hidden="true">✎</span>
                                    <span>Edit</span>
                                </button>
                                <button class="event-selection-action event-selection-action-danger" type="button" @onclick="OpenDeleteConfirmation">
                                    <span class="event-selection-action-icon" aria-hidden="true">⌫</span>
                                    <span>Delete</span>
                                </button>
                                <button class="event-selection-action" type="button" @onclick="ClearSelection">
                                    <span class="event-selection-action-icon" aria-hidden="true">&times;</span>
                                    <span>Close</span>
                                </button>
                            </div>
                        </section>
                        @if (selectedEvent.ImageUrl is not null)
                        {
                            <img src="@ApiUrl(selectedEvent.ImageUrl)" alt="" class="event-preview-image" />
                        }
                        <p class="event-preview-date">@DisplayDateRange(selectedEvent)</p>
                        <h2>@selectedEvent.Title</h2>
                        <p class="event-preview-summary">@selectedEvent.Summary</p>
                        <p class="event-preview-description">@selectedEvent.Description</p>
                    </article>
                </aside>
            }
        </div>
    }
</section>

@if (showEditor)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="event-editor-title">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="event-editor-title">@(editingId is null ? "Add an event" : "Edit event")</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="ResetForm"></button>
                </div>
                <div class="modal-body">
                    @if (saveError is not null)
                    {
                        <div class="alert alert-danger">@saveError</div>
                    }
                    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="historical-event">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label" for="title">Title</label>
                            <InputText id="title" class="form-control" @bind-Value="form.Title" />
                            <ValidationMessage For="() => form.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="summary">Summary</label>
                            <InputTextArea id="summary" class="form-control" @bind-Value="form.Summary" />
                            <ValidationMessage For="() => form.Summary" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="description">Description</label>
                            <InputTextArea id="description" class="form-control" rows="6" @bind-Value="form.Description" />
                            <ValidationMessage For="() => form.Description" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="start-date">Start date</label>
                                <InputDate id="start-date" class="form-control" @bind-Value="form.StartDate" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="end-date">End date</label>
                                <InputDate id="end-date" class="form-control" @bind-Value="form.EndDate" />
                                <ValidationMessage For="() => form.EndDate" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="image">Image @(editingId is null ? "" : "(optional)")</label>
                            @if (editingImageUrl is not null)
                            {
                                <div class="mb-2">
                                    <img src="@ApiUrl(editingImageUrl)" alt="Current image" class="editor-image" />
                                </div>
                            }
                            <InputFile id="image" class="form-control" OnChange="SelectImage" accept="image/jpeg,image/png,image/gif,image/webp" />
                            @if (imageError is not null)
                            {
                                <div class="validation-message">@imageError</div>
                            }
                            else if (selectedImage is not null)
                            {
                                <div class="form-text">Selected image: @selectedImage.Name</div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@saving">@(saving ? "Saving..." : "Save event")</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (eventPendingDeletion is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-event-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="delete-event-title">Delete event</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelDelete" disabled="@deleting"></button>
                </div>
                <div class="modal-body">
                    @if (deleteError is not null)
                    {
                        <div class="alert alert-danger">@deleteError</div>
                    }
                    <p>Are you sure you want to delete <strong>@eventPendingDeletion.Title</strong>?</p>
                    <p class="mb-0 text-muted">This permanently removes the event and its image.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelDelete" disabled="@deleting">Cancel</button>
                    <button class="btn btn-danger" type="button" @onclick="DeleteAsync" disabled="@deleting">@(deleting ? "Deleting..." : "Delete event")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showTimelineEditor)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="timeline-editor-title">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="timeline-editor-title">Edit timeline</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseTimelineEditor"></button>
                </div>
                <div class="modal-body">
                    @if (timelineSaveError is not null)
                    {
                        <div class="alert alert-danger">@timelineSaveError</div>
                    }
                    <EditForm Model="timelineForm" OnValidSubmit="SaveTimelineAsync" FormName="timeline-metadata">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label" for="timeline-title">Title</label>
                            <InputText id="timeline-title" class="form-control" @bind-Value="timelineForm.Title" />
                            <ValidationMessage For="() => timelineForm.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="timeline-description">Description</label>
                            <InputTextArea id="timeline-description" class="form-control" rows="4" @bind-Value="timelineForm.Description" />
                            <ValidationMessage For="() => timelineForm.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="timeline-image">Image (optional)</label>
                            @if (timelineImageUrl is not null)
                            {
                                <div class="mb-2">
                                    <img src="@ApiUrl(timelineImageUrl)" alt="Current timeline image" class="editor-image" />
                                </div>
                            }
                            <InputFile id="timeline-image" class="form-control" OnChange="SelectTimelineImage" accept="image/jpeg,image/png,image/gif,image/webp" />
                            @if (timelineImageError is not null)
                            {
                                <div class="validation-message">@timelineImageError</div>
                            }
                            else if (selectedTimelineImage is not null)
                            {
                                <div class="form-text">Selected image: @selectedTimelineImage.Name</div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@timelineSaving">@(timelineSaving ? "Saving..." : "Save timeline")</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CloseTimelineEditor">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (timelinePendingDeletion is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-timeline-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="delete-timeline-title">Delete timeline</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelTimelineDelete" disabled="@timelineDeleting"></button>
                </div>
                <div class="modal-body">
                    @if (timelineDeleteError is not null)
                    {
                        <div class="alert alert-danger">@timelineDeleteError</div>
                    }
                    <p>Are you sure you want to delete <strong>@timelinePendingDeletion.Title</strong>?</p>
                    <p class="mb-0 text-muted">This permanently removes the timeline, all of its events, and all associated images.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelTimelineDelete" disabled="@timelineDeleting">Cancel</button>
                    <button class="btn btn-danger" type="button" @onclick="DeleteTimelineAsync" disabled="@timelineDeleting">@(timelineDeleting ? "Deleting..." : "Delete timeline")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long MaximumImageSize = 5 * 1024 * 1024;

    [Parameter]
    public Guid TimelineId { get; set; }

    private TimelineTopic? timeline;
    private List<HistoricalEvent>? events;
    private Guid? selectedEventId;
    private HistoricalEventForm form = new();
    private TimelineTopicForm timelineForm = new();
    private IBrowserFile? selectedImage;
    private IBrowserFile? selectedTimelineImage;
    private Guid? editingId;
    private string? editingImageUrl;
    private string? timelineImageUrl;
    private HistoricalEvent? eventPendingDeletion;
    private TimelineTopic? timelinePendingDeletion;
    private bool showEditor;
    private bool showTimelineEditor;
    private bool saving;
    private bool deleting;
    private bool timelineSaving;
    private bool timelineDeleting;
    private string? loadError;
    private string? saveError;
    private string? imageError;
    private string? deleteError;
    private string? timelineSaveError;
    private string? timelineImageError;
    private string? timelineDeleteError;
    private HistoricalEvent? SelectedEvent =>
        events?.FirstOrDefault(historicalEvent => historicalEvent.Id == selectedEventId);

    protected override async Task OnParametersSetAsync() => await LoadTimelineAsync();

    private async Task LoadTimelineAsync()
    {
        timeline = null;
        events = null;
        selectedEventId = null;
        loadError = null;

        try
        {
            timeline = await Http.GetFromJsonAsync<TimelineTopic>($"api/timelines/{TimelineId:N}");
            if (timeline is null)
            {
                loadError = "The requested timeline could not be found.";
                return;
            }

            await LoadEventsAsync();
        }
        catch (HttpRequestException)
        {
            loadError = "The requested timeline could not be loaded. Start the API and try again.";
        }
    }

    private async Task LoadEventsAsync()
    {
        try
        {
            events = await Http.GetFromJsonAsync<List<HistoricalEvent>>(
                $"api/timelines/{TimelineId:N}/historical-events") ?? [];
            if (SelectedEvent is null)
            {
                selectedEventId = null;
            }
        }
        catch (HttpRequestException)
        {
            loadError = "The events service is unavailable. Start the API and try again.";
        }
    }

    private void SelectImage(InputFileChangeEventArgs args)
    {
        selectedImage = args.File;
        imageError = selectedImage.Size > MaximumImageSize ? "Images must be 5 MB or smaller." : null;
    }

    private void SelectTimelineImage(InputFileChangeEventArgs args)
    {
        selectedTimelineImage = args.File;
        timelineImageError = selectedTimelineImage.Size > MaximumImageSize
            ? "Images must be 5 MB or smaller."
            : null;
    }

    private async Task SaveAsync()
    {
        saveError = null;
        if (imageError is not null)
        {
            return;
        }

        saving = true;
        using var content = new MultipartFormDataContent();
        content.Add(new StringContent(form.Title), "title");
        content.Add(new StringContent(form.Summary), "summary");
        content.Add(new StringContent(form.Description), "description");
        content.Add(new StringContent(form.StartDate.ToString("yyyy-MM-dd")), "startDate");
        content.Add(new StringContent(form.EndDate.ToString("yyyy-MM-dd")), "endDate");
        if (selectedImage is not null)
        {
            var imageContent = new StreamContent(selectedImage.OpenReadStream(MaximumImageSize));
            imageContent.Headers.ContentType = new(selectedImage.ContentType);
            content.Add(imageContent, "image", selectedImage.Name);
        }

        try
        {
            using var response = editingId is null
                ? await Http.PostAsync($"api/timelines/{TimelineId:N}/historical-events", content)
                : await Http.PutAsync(
                    $"api/timelines/{TimelineId:N}/historical-events/{editingId:N}",
                    content);

            if (!response.IsSuccessStatusCode)
            {
                saveError = "The event could not be saved. Check the information and try again.";
                return;
            }

            ResetForm();
            await LoadEventsAsync();
        }
        catch (HttpRequestException)
        {
            saveError = "The events service is unavailable. Start the API and try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private void Edit(HistoricalEvent historicalEvent)
    {
        editingId = historicalEvent.Id;
        form = new HistoricalEventForm
        {
            Title = historicalEvent.Title,
            Summary = historicalEvent.Summary,
            Description = historicalEvent.Description,
            StartDate = historicalEvent.StartDate,
            EndDate = historicalEvent.EndDate
        };
        selectedImage = null;
        editingImageUrl = historicalEvent.ImageUrl;
        imageError = null;
        saveError = null;
        showEditor = true;
    }

    private void SelectEvent(Guid eventId) => selectedEventId = eventId;

    private void ClearSelection() => selectedEventId = null;

    private void SelectEventOnKeyDown(KeyboardEventArgs args, Guid eventId)
    {
        if (args.Key is "Enter" or " ")
        {
            SelectEvent(eventId);
        }
    }

    private void EditSelectedEvent()
    {
        if (SelectedEvent is { } selectedEvent)
        {
            Edit(selectedEvent);
        }
    }

    private void OpenDeleteConfirmation()
    {
        if (SelectedEvent is { } selectedEvent)
        {
            eventPendingDeletion = selectedEvent;
            deleteError = null;
        }
    }

    private void OpenCreate()
    {
        ResetForm();
        showEditor = true;
    }

    private void OpenTimelineEditor()
    {
        if (timeline is null)
        {
            return;
        }

        timelineForm = new TimelineTopicForm
        {
            Title = timeline.Title,
            Description = timeline.Description
        };
        selectedTimelineImage = null;
        timelineImageUrl = timeline.ImageUrl;
        timelineImageError = null;
        timelineSaveError = null;
        showTimelineEditor = true;
    }

    private void CloseTimelineEditor()
    {
        showTimelineEditor = false;
        selectedTimelineImage = null;
        timelineImageUrl = null;
        timelineImageError = null;
        timelineSaveError = null;
    }

    private void OpenTimelineDeleteConfirmation()
    {
        if (timeline is not null)
        {
            timelinePendingDeletion = timeline;
            timelineDeleteError = null;
        }
    }

    private void CancelTimelineDelete()
    {
        timelinePendingDeletion = null;
        timelineDeleteError = null;
    }

    private async Task DeleteTimelineAsync()
    {
        if (timelinePendingDeletion is null)
        {
            return;
        }

        timelineDeleting = true;
        timelineDeleteError = null;
        try
        {
            using var response = await Http.DeleteAsync($"api/timelines/{TimelineId:N}");
            if (!response.IsSuccessStatusCode)
            {
                timelineDeleteError = "The timeline could not be deleted. Try again.";
                return;
            }

            Navigation.NavigateTo("");
        }
        catch (HttpRequestException)
        {
            timelineDeleteError = "The timelines service is unavailable. Start the API and try again.";
        }
        finally
        {
            timelineDeleting = false;
        }
    }

    private async Task SaveTimelineAsync()
    {
        timelineSaveError = null;
        if (timelineImageError is not null)
        {
            return;
        }

        timelineSaving = true;
        using var content = new MultipartFormDataContent();
        content.Add(new StringContent(timelineForm.Title), "title");
        content.Add(new StringContent(timelineForm.Description), "description");
        if (selectedTimelineImage is not null)
        {
            var imageContent = new StreamContent(selectedTimelineImage.OpenReadStream(MaximumImageSize));
            imageContent.Headers.ContentType = new(selectedTimelineImage.ContentType);
            content.Add(imageContent, "image", selectedTimelineImage.Name);
        }

        try
        {
            using var response = await Http.PutAsync($"api/timelines/{TimelineId:N}", content);
            if (!response.IsSuccessStatusCode)
            {
                timelineSaveError = "The timeline could not be saved. Check the information and try again.";
                return;
            }

            timeline = await response.Content.ReadFromJsonAsync<TimelineTopic>();
            CloseTimelineEditor();
        }
        catch (HttpRequestException)
        {
            timelineSaveError = "The timelines service is unavailable. Start the API and try again.";
        }
        finally
        {
            timelineSaving = false;
        }
    }

    private void ResetForm()
    {
        editingId = null;
        form = new HistoricalEventForm();
        selectedImage = null;
        editingImageUrl = null;
        imageError = null;
        saveError = null;
        deleting = false;
        showEditor = false;
    }

    private void CancelDelete()
    {
        eventPendingDeletion = null;
        deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (eventPendingDeletion is null)
        {
            return;
        }

        var eventId = eventPendingDeletion.Id;
        deleting = true;
        deleteError = null;
        try
        {
            using var response = await Http.DeleteAsync(
                $"api/timelines/{TimelineId:N}/historical-events/{eventId:N}");
            if (!response.IsSuccessStatusCode)
            {
                deleteError = "The event could not be deleted. Try again.";
                return;
            }

            selectedEventId = null;
            eventPendingDeletion = null;
            await LoadEventsAsync();
        }
        catch (HttpRequestException)
        {
            deleteError = "The events service is unavailable. Start the API and try again.";
        }
        finally
        {
            deleting = false;
        }
    }

    private static string DisplayDateRange(HistoricalEvent historicalEvent) =>
        historicalEvent.StartDate == historicalEvent.EndDate
            ? historicalEvent.StartDate.ToString("d MMMM yyyy")
            : $"{historicalEvent.StartDate:d MMMM yyyy} - {historicalEvent.EndDate:d MMMM yyyy}";

    private string ApiUrl(string relativeUrl) => new Uri(Http.BaseAddress!, relativeUrl).ToString();
}
