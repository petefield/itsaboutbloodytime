@page "/timeline"
@inject HttpClient Http

<PageTitle>Event Timeline</PageTitle>

<section class="timeline-page">
    <div class="event-toolbar">
        <div>
            <h1>Event timeline</h1>
            <p class="mb-0 text-muted">Explore events in chronological order.</p>
        </div>
        <a class="btn btn-outline-primary" href="">Event list</a>
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else if (events is null)
    {
        <p>Loading events...</p>
    }
    else if (events.Count == 0)
    {
        <p class="text-muted">No events have been added yet.</p>
    }
    else
    {
        <div class="timeline-scroll">
            <div class="timeline-track" style="@($"width: {timelineWidth}px; min-height: {timelineHeight}px;")">
                <div class="timeline-axis" aria-hidden="true"></div>
                @foreach (var placement in timelinePlacements)
                {
                    <div class="timeline-range"
                         style="@($"left: {placement.Left:F1}px; width: {placement.RangeWidth:F1}px;")"
                         aria-hidden="true"></div>
                    <button class="timeline-event"
                            style="@PositionEvent(placement)"
                            @onclick="() => OpenDetails(placement.Event)">
                        @if (placement.Event.ImageUrl is not null)
                        {
                            <img src="@ApiUrl(placement.Event.ImageUrl)" alt="" class="timeline-thumbnail" />
                        }
                        <span class="timeline-date">@DisplayDateRange(placement.Event)</span>
                        <span class="timeline-title">@placement.Event.Title</span>
                        <span class="timeline-summary">@placement.Event.Summary</span>
                    </button>
                }
            </div>
        </div>
    }
</section>

@if (selectedEvent is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="event-details-title">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="event-details-title">@selectedEvent.Title</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    @if (selectedEvent.ImageUrl is not null)
                    {
                        <img src="@ApiUrl(selectedEvent.ImageUrl)" alt="" class="event-detail-image mb-3" />
                    }
                    <p class="timeline-date">@DisplayDateRange(selectedEvent)</p>
                    <p>@selectedEvent.Summary</p>
                    <p class="mb-0">@selectedEvent.Description</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetails">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int EventCardWidth = 240;
    private const int LaneHeight = 260;
    private const int AxisClearance = 32;
    private const int MinimumTimelineWidth = 1_600;
    private List<HistoricalEvent>? events;
    private List<TimelinePlacement> timelinePlacements = [];
    private HistoricalEvent? selectedEvent;
    private string? loadError;
    private int timelineWidth;
    private int timelineHeight;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            events = await Http.GetFromJsonAsync<List<HistoricalEvent>>("api/historical-events") ?? [];
            BuildTimelinePlacements();
        }
        catch (HttpRequestException)
        {
            loadError = "The events service is unavailable. Start the API and try again.";
        }
    }

    private void OpenDetails(HistoricalEvent historicalEvent) => selectedEvent = historicalEvent;

    private void CloseDetails() => selectedEvent = null;

    private void BuildTimelinePlacements()
    {
        var orderedEvents = events!.OrderBy(historicalEvent => historicalEvent.StartDate).ToArray();
        if (orderedEvents.Length == 0)
        {
            return;
        }

        var timelineStart = orderedEvents[0].StartDate;
        var timelineEnd = orderedEvents.Max(historicalEvent => historicalEvent.EndDate);
        var durationInDays = Math.Max(1, timelineEnd.DayNumber - timelineStart.DayNumber);
        var pixelsPerDay = (double)MinimumTimelineWidth / durationInDays;
        var aboveLaneEnds = new List<double>();
        var belowLaneEnds = new List<double>();

        foreach (var (historicalEvent, index) in orderedEvents.Select((historicalEvent, index) => (historicalEvent, index)))
        {
            var above = index % 2 == 0;
            var left = (historicalEvent.StartDate.DayNumber - timelineStart.DayNumber) * pixelsPerDay;
            var rangeWidth = Math.Max(4, (historicalEvent.EndDate.DayNumber - historicalEvent.StartDate.DayNumber) * pixelsPerDay);
            var laneEnds = above ? aboveLaneEnds : belowLaneEnds;
            var lane = laneEnds.FindIndex(end => end <= left);

            if (lane < 0)
            {
                lane = laneEnds.Count;
                laneEnds.Add(left + EventCardWidth);
            }
            else
            {
                laneEnds[lane] = left + EventCardWidth;
            }

            timelinePlacements.Add(new TimelinePlacement(historicalEvent, above, lane, left, rangeWidth));
        }

        timelineWidth = Math.Max(
            MinimumTimelineWidth,
            (int)Math.Ceiling(durationInDays * pixelsPerDay) + EventCardWidth);
        timelineHeight = (aboveLaneEnds.Count + belowLaneEnds.Count) * LaneHeight + (AxisClearance * 2);
    }

    private string PositionEvent(TimelinePlacement placement)
    {
        var distanceFromAxis = AxisClearance + (placement.Lane * LaneHeight);
        var verticalPosition = placement.Above
            ? $"bottom: {timelineHeight / 2 + distanceFromAxis}px;"
            : $"top: {timelineHeight / 2 + distanceFromAxis}px;";

        return $"left: {placement.Left:F1}px; {verticalPosition}";
    }

    private static string DisplayDateRange(HistoricalEvent historicalEvent) =>
        historicalEvent.StartDate == historicalEvent.EndDate
            ? historicalEvent.StartDate.ToString("d MMMM yyyy")
            : $"{historicalEvent.StartDate:d MMMM yyyy} - {historicalEvent.EndDate:d MMMM yyyy}";

    private string ApiUrl(string relativeUrl) => new Uri(Http.BaseAddress!, relativeUrl).ToString();

    private sealed record TimelinePlacement(
        HistoricalEvent Event,
        bool Above,
        int Lane,
        double Left,
        double RangeWidth);
}
