@page "/"
@inject HttpClient Http

<PageTitle>Timeline topics</PageTitle>

<section class="event-page">
    <div class="event-toolbar">
        <div>
            <h1>Timeline topics</h1>
            <p class="mb-0 text-muted">Create a topic, then record the events that shaped it.</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Create a timeline</h2>
            @if (saveError is not null)
            {
                <div class="alert alert-danger">@saveError</div>
            }
            <EditForm Model="form" OnValidSubmit="CreateTimelineAsync" FormName="timeline-topic">
                <DataAnnotationsValidator />
                <div class="input-group">
                    <InputText class="form-control" @bind-Value="form.Title" placeholder="Timeline title" aria-label="Timeline title" />
                    <button class="btn btn-primary" type="submit" disabled="@saving">@(saving ? "Creating..." : "Create timeline")</button>
                </div>
                <ValidationMessage For="() => form.Title" />
            </EditForm>
        </div>
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else if (timelines is null)
    {
        <p>Loading timelines...</p>
    }
    else if (timelines.Count == 0)
    {
        <p class="text-muted">No timelines have been created yet.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var timeline in timelines)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                   href="@($"timelines/{timeline.Id:N}")">
                    <span>@timeline.Title</span>
                    <span class="text-muted">Edit events <span aria-hidden="true">→</span></span>
                </a>
            }
        </div>
    }
</section>

@code {
    private List<TimelineTopic>? timelines;
    private TimelineTopicForm form = new();
    private bool saving;
    private string? loadError;
    private string? saveError;

    protected override async Task OnInitializedAsync() => await LoadTimelinesAsync();

    private async Task LoadTimelinesAsync()
    {
        loadError = null;
        try
        {
            timelines = await Http.GetFromJsonAsync<List<TimelineTopic>>("api/timelines") ?? [];
        }
        catch (HttpRequestException)
        {
            loadError = "The timelines service is unavailable. Start the API and try again.";
        }
    }

    private async Task CreateTimelineAsync()
    {
        saveError = null;
        saving = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/timelines", form);
            if (!response.IsSuccessStatusCode)
            {
                saveError = "The timeline could not be created. Check the title and try again.";
                return;
            }

            form = new TimelineTopicForm();
            await LoadTimelinesAsync();
        }
        catch (HttpRequestException)
        {
            saveError = "The timelines service is unavailable. Start the API and try again.";
        }
        finally
        {
            saving = false;
        }
    }
}
