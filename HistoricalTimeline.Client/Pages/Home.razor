@page "/"
@inject HttpClient Http

<PageTitle>Timeline topics</PageTitle>

<section class="event-page">
    <div class="page-heading archive-hero">
        <div class="archive-hero-content">
            <p class="eyebrow">Your historical archive</p>
            <h1>Timeline topics</h1>
            <p class="page-introduction">Create a topic, then record the events that shaped it.</p>
        </div>
        <div class="archive-hero-art" aria-hidden="true">
            <span class="archive-hero-node archive-hero-node-one"></span>
            <span class="archive-hero-node archive-hero-node-two"></span>
            <span class="archive-hero-node archive-hero-node-three"></span>
            <span class="archive-hero-clock">◷</span>
        </div>
    </div>

    <div class="event-toolbar timeline-list-toolbar">
        <div>
            <h2 class="section-heading">Your timelines</h2>
            <p class="section-introduction">Choose a timeline to explore its events.</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreate">Create timeline <span aria-hidden="true">→</span></button>
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger">@loadError</div>
    }
    else if (timelines is null)
    {
        <p>Loading timelines...</p>
    }
    else if (timelines.Count == 0)
    {
        <div class="empty-timelines">
            <span class="create-timeline-icon" aria-hidden="true">+</span>
            <h2>No timelines yet</h2>
            <p>Create your first timeline to start preserving historical events.</p>
        </div>
    }
    else
    {
        <div class="topic-grid">
            @foreach (var timeline in timelines)
            {
                <article class="topic-card">
                    <a class="topic-card-main" href="@($"timelines/{timeline.Id:N}")">
                        @if (timeline.ImageUrl is not null)
                        {
                            <img src="@ApiUrl(timeline.ImageUrl)" alt="" class="topic-card-image" />
                        }
                        else
                        {
                            <span class="topic-card-icon" aria-hidden="true">◷</span>
                        }
                        <span class="topic-card-copy">
                            <span class="topic-card-title">@timeline.Title</span>
                            <span class="topic-card-description">@(string.IsNullOrWhiteSpace(timeline.Description) ? "Add a description to this timeline." : timeline.Description)</span>
                        </span>
                    </a>
                    <a class="topic-card-action" href="@($"timelines/{timeline.Id:N}")">Open timeline <span aria-hidden="true">→</span></a>
                </article>
            }
        </div>
    }
</section>

@if (showEditor)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="timeline-editor-title">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="timeline-editor-title">Create a timeline</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseEditor"></button>
                </div>
                <div class="modal-body">
                    @if (saveError is not null)
                    {
                        <div class="alert alert-danger">@saveError</div>
                    }
                    <EditForm Model="form" OnValidSubmit="SaveTimelineAsync" FormName="timeline-topic">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-3">
                            <label class="form-label" for="timeline-title">Title</label>
                            <InputText id="timeline-title" class="form-control" @bind-Value="form.Title" />
                            <ValidationMessage For="() => form.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="timeline-description">Description</label>
                            <InputTextArea id="timeline-description" class="form-control" rows="4" @bind-Value="form.Description" />
                            <ValidationMessage For="() => form.Description" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="timeline-image">Image (optional)</label>
                            <InputFile id="timeline-image" class="form-control" OnChange="SelectImage" accept="image/jpeg,image/png,image/gif,image/webp" />
                            @if (imageError is not null)
                            {
                                <div class="validation-message">@imageError</div>
                            }
                            else if (selectedImage is not null)
                            {
                                <div class="form-text">Selected image: @selectedImage.Name</div>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit" disabled="@saving">@(saving ? "Saving..." : "Save timeline")</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CloseEditor">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long MaximumImageSize = 5 * 1024 * 1024;

    private List<TimelineTopic>? timelines;
    private TimelineTopicForm form = new();
    private IBrowserFile? selectedImage;
    private bool showEditor;
    private bool saving;
    private string? loadError;
    private string? saveError;
    private string? imageError;

    protected override async Task OnInitializedAsync() => await LoadTimelinesAsync();

    private async Task LoadTimelinesAsync()
    {
        loadError = null;
        try
        {
            timelines = await Http.GetFromJsonAsync<List<TimelineTopic>>("api/timelines") ?? [];
        }
        catch (HttpRequestException)
        {
            loadError = "The timelines service is unavailable. Start the API and try again.";
        }
    }

    private void OpenCreate()
    {
        form = new TimelineTopicForm();
        selectedImage = null;
        imageError = null;
        saveError = null;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        selectedImage = null;
        imageError = null;
        saveError = null;
    }

    private void SelectImage(InputFileChangeEventArgs args)
    {
        selectedImage = args.File;
        imageError = selectedImage.Size > MaximumImageSize ? "Images must be 5 MB or smaller." : null;
    }

    private async Task SaveTimelineAsync()
    {
        saveError = null;
        if (imageError is not null)
        {
            return;
        }

        saving = true;
        using var content = new MultipartFormDataContent();
        content.Add(new StringContent(form.Title), "title");
        content.Add(new StringContent(form.Description), "description");
        if (selectedImage is not null)
        {
            var imageContent = new StreamContent(selectedImage.OpenReadStream(MaximumImageSize));
            imageContent.Headers.ContentType = new(selectedImage.ContentType);
            content.Add(imageContent, "image", selectedImage.Name);
        }

        try
        {
            using var response = await Http.PostAsync("api/timelines", content);
            if (!response.IsSuccessStatusCode)
            {
                saveError = "The timeline could not be saved. Check the information and try again.";
                return;
            }

            CloseEditor();
            await LoadTimelinesAsync();
        }
        catch (HttpRequestException)
        {
            saveError = "The timelines service is unavailable. Start the API and try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private string ApiUrl(string relativeUrl) => new Uri(Http.BaseAddress!, relativeUrl).ToString();
}
